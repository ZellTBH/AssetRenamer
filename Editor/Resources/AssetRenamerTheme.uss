/* Theme Breaking Frame de la fenetre Asset Renamer, transpose de BreakingFrameTheme.md.
   Flat et anguleux : rayon 0, pas d'ombre, surfaces opaques, separation par bordures.
   Les tokens sont declares UNE fois, ici, sur .ar-root et non sur :root (qui peut ne pas
   matcher la racine d'une EditorWindow) ; les descendants en heritent. Aucune couleur en dur
   ailleurs dans ce fichier ni dans le C#. */

/* ============ TOKENS ============ */
.ar-root {
    --ar-bg: #0A0A0A;
    --ar-surface: #141414;
    --ar-surface-2: #1A1A1A;
    --ar-border: #2E2E2E;
    --ar-border-strong: #6E6E6E;
    --ar-accent: #0047FF;
    --ar-accent-hover: #1E5AFF;
    --ar-orange: #FF5A1F;
    --ar-link: #5C90FF;
    --ar-success: #3ECF8E;
    --ar-warning: #E8B23A;
    --ar-error: #C42B1C;
    --ar-error-text: #E55648;
    --ar-on-accent: #FFFFFF;
    --ar-text: #E8E8E8;
    --ar-text-muted: #A8A8A8;
    --ar-text-faint: #555555;
}

/* ============ RACINE / MISE EN PAGE ============ */
.ar-root {
    flex-grow: 1;
    min-height: 0;
    padding: 0;
    background-color: var(--ar-bg);
    color: var(--ar-text);
}
.ar-root Label {
    white-space: normal;
}
.ar-scroll {
    flex-grow: 1;
    min-height: 0;
}
.ar-content {
    padding: 12px;
}
.ar-panel {
    flex-shrink: 0;
    margin-bottom: 10px;
}

/* ============ BANNIERE ============ */
.ar-banner {
    flex-shrink: 0;
    width: 100%;
    margin-bottom: 14px;
}

/* ============ GROUPES (FORMAT / CLEANUP / PREFIXES) ============ */
.ar-group {
    flex-shrink: 0;
    margin-bottom: 16px;
    padding: 16px 18px;
    background-color: var(--ar-surface);
    border-width: 1px;
    border-color: var(--ar-border);
    border-radius: 0;
}
.ar-group-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}

/* Titres de section : majuscules espacees. Le bleu accent echoue en texte (2.9:1 sur surface) :
   le texte bleu passe toujours par --ar-link. 11px minimum pour tout texte. */
.ar-group-title,
.ar-section-title,
.ar-preview-title {
    -unity-font-style: bold;
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--ar-link);
    margin-top: 0;
    margin-right: 8px;
}
.ar-section-title {
    margin-bottom: 6px;
}

/* Unity ne compte pas le letter-spacing dans la mesure de largeur : avec le white-space normal
   de .ar-root Label, plus specifique qu'une classe seule, les titres se coupaient ("FORMA / T").
   Deux classes battent classe + type : cette regle l'emporte sur .ar-root Label. */
.ar-root .ar-group-title,
.ar-root .ar-section-title,
.ar-root .ar-preview-title {
    white-space: nowrap;
    flex-shrink: 0;
}

/* ============ CHAMPS ============ */
.ar-group .unity-base-field__label,
.ar-field-row .unity-base-field__label {
    min-width: 120px;
    -unity-text-align: middle-left;
    color: var(--ar-text-muted);
    font-size: 12px;
}
.ar-root .unity-base-popup-field__input,
.ar-root .unity-object-field__input,
.ar-root .unity-base-field__input {
    background-color: var(--ar-bg);
    border-width: 1px;
    border-color: var(--ar-border-strong);
    border-radius: 0;
    color: var(--ar-text);
}
/* Focus : accent-hover tient 3.7:1 contre le fond du champ et 3.5:1 contre la surface du
   groupe, la ou l'accent pur tombe a 2.9:1. Il reste dans la famille du bleu electric. */
.ar-root .unity-base-field:focus:enabled > .unity-base-field__input,
.ar-root .unity-base-field:focus:enabled > .unity-base-popup-field__input,
.ar-root .unity-base-field:focus:enabled > .unity-object-field__input {
    border-color: var(--ar-accent-hover);
}
.ar-field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}
.ar-field-grow {
    flex-grow: 1;
}
.ar-group .unity-base-popup-field,
.ar-group .unity-object-field {
    margin-bottom: 8px;
}

/* ============ BOUTON D'AIDE "?" ============ */
.ar-help-button {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-left: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--ar-border-strong);
    border-radius: 0;
    color: var(--ar-text-muted);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.ar-help-button:hover {
    border-color: var(--ar-link);
    color: var(--ar-link);
}

/* ============ PANNEAU D'AIDE ============ */
.ar-help-panel {
    padding: 8px;
    margin-bottom: 10px;
    background-color: var(--ar-bg);
    border-width: 1px;
    border-color: var(--ar-border);
    border-radius: 0;
}
.ar-help-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 4px;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
}
.ar-help-row--active {
    background-color: var(--ar-surface-2);
    border-left-color: var(--ar-link);
}
.ar-help-name {
    color: var(--ar-text-muted);
    font-size: 12px;
}
.ar-help-example {
    color: var(--ar-text);
    font-size: 12px;
    -unity-font-style: bold;
}

/* ============ TOGGLES ============ */
.ar-toggle {
    margin-bottom: 8px;
}
.ar-toggle .unity-base-field__label {
    min-width: 0;
    width: auto;
}
.ar-toggle .unity-toggle__input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.ar-toggle .unity-toggle__label,
.ar-toggle .unity-toggle__text {
    color: var(--ar-text);
    font-size: 13px;
}
.ar-toggle .unity-toggle__text {
    margin-left: 6px;
}
.ar-toggle .unity-toggle__checkmark {
    width: 18px;
    height: 18px;
    border-width: 1px;
    border-color: var(--ar-border-strong);
    border-radius: 0;
    background-color: var(--ar-bg);
    -unity-background-image-tint-color: var(--ar-on-accent);
}
/* Le contour reste border-strong une fois coche : le fond accent seul ne tient que 2.9:1
   contre la surface, la coche blanche porte l'etat. */
.ar-toggle:checked .unity-toggle__checkmark {
    background-color: var(--ar-accent);
}

/* ============ BOUTONS ============ */
/* Secondaire par defaut : transparent, contour, texte attenue ; le bleu lien au survol. */
.ar-button {
    padding: 6px 10px;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--ar-border-strong);
    border-radius: 0;
    color: var(--ar-text-muted);
    -unity-font-style: bold;
}
.ar-button:hover {
    border-color: var(--ar-link);
    color: var(--ar-link);
}
.ar-button:active {
    background-color: var(--ar-surface-2);
}

/* Primaire : fond accent plein. Texte blanc pur : --ar-text tombe a 4.3:1 sur accent-hover. */
.ar-button--primary {
    background-color: var(--ar-accent);
    border-color: var(--ar-accent);
    color: var(--ar-on-accent);
}
.ar-button--primary:hover {
    background-color: var(--ar-accent-hover);
    border-color: var(--ar-accent-hover);
    color: var(--ar-on-accent);
}
.ar-button--primary:active {
    background-color: var(--ar-accent);
}

/* Update available : seul usage de l'orange studio, en badge (transparent, texte et bordure). */
.ar-button--update {
    border-color: var(--ar-orange);
    color: var(--ar-orange);
}
.ar-button--update:hover {
    background-color: var(--ar-orange);
    border-color: var(--ar-orange);
    color: var(--ar-bg);
}

.ar-button-row {
    flex-direction: row;
}
.ar-add-selection {
    flex-shrink: 0;
    margin: 0 0 10px 0;
}

/* ============ FOLDOUT AVANCE ============ */
.ar-advanced {
    margin-bottom: 0;
}
.ar-advanced .unity-foldout__text {
    color: var(--ar-text-muted);
    font-size: 13px;
}
.ar-advanced .unity-base-field {
    margin-bottom: 6px;
}

/* ============ AVERTISSEMENT ============ */
.ar-warning {
    color: var(--ar-warning);
    font-size: 12px;
    margin-top: 4px;
    margin-bottom: 6px;
}

/* ============ ZONE DE DEPOT ============ */
.ar-dropzone {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding: 24px;
    margin-bottom: 12px;
    background-color: var(--ar-bg);
    border-width: 1px;
    border-color: var(--ar-border-strong);
    border-radius: 0;
}
.ar-dropzone-icon {
    width: 44px;
    height: 44px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: var(--ar-border);
    border-radius: 0;
}
.ar-dropzone-label {
    color: var(--ar-text-muted);
    font-size: 14px;
}
.ar-dropzone-types {
    margin-top: 6px;
    color: var(--ar-text-muted);
    font-size: 11px;
    -unity-text-align: middle-center;
}

/* ============ PREVIEW : EN-TETE ============ */
.ar-preview {
    flex-grow: 1;
    min-height: 0;
}
.ar-preview-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 8px;
}
.ar-badge {
    min-width: 16px;
    padding: 1px 7px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--ar-border);
    border-radius: 0;
    color: var(--ar-text);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.ar-preview-spacer {
    flex-grow: 1;
}
.ar-preview-counts {
    flex-direction: row;
    font-size: 11px;
    color: var(--ar-text-muted);
}
.ar-preview-issues {
    color: var(--ar-warning);
    -unity-font-style: bold;
}

/* ============ PREVIEW : LIGNES ============ */
.ar-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 8px;
    background-color: var(--ar-surface);
    border-width: 1px;
    border-color: var(--ar-border);
    border-left-width: 3px;
    border-radius: 0;
}
.ar-row:hover {
    background-color: var(--ar-surface-2);
}
.ar-row-toggle {
    flex-shrink: 0;
    margin-right: 8px;
}
.ar-row-content {
    flex-grow: 1;
}
.ar-row-names {
    color: var(--ar-text);
    font-size: 12px;
}
.ar-row-status {
    margin-top: 3px;
    font-size: 11px;
}

/* Palette d'etats unique. La classe d'etat est posee sur la ligne : elle colore la barre de
   gauche et le libelle de statut. Le mot du statut reste affiche, la couleur ne porte rien seule.
   text-faint ne sert qu'aux barres (redondantes avec le mot), jamais au texte. Pas d'opacite sur
   Excluded : elle ecrasait le contraste de toute la ligne. */
.ar-row.ar-status--ok { border-left-color: var(--ar-success); }
.ar-status--ok .ar-row-status { color: var(--ar-success); }

.ar-row.ar-status--unchanged { border-left-color: var(--ar-text-faint); }
.ar-status--unchanged .ar-row-status { color: var(--ar-text-muted); }

.ar-row.ar-status--collision { border-left-color: var(--ar-warning); }
.ar-status--collision .ar-row-status { color: var(--ar-warning); }

.ar-row.ar-status--invalid { border-left-color: var(--ar-error); }
.ar-status--invalid .ar-row-status { color: var(--ar-error-text); }

.ar-row.ar-status--excluded { border-left-color: var(--ar-text-faint); }
.ar-status--excluded .ar-row-names,
.ar-status--excluded .ar-row-status { color: var(--ar-text-muted); }

/* ============ RESULTAT / VERSION ============ */
.ar-result {
    margin-bottom: 6px;
    color: var(--ar-text-muted);
    font-size: 12px;
}
.ar-versionbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.ar-version-label {
    margin-right: 8px;
    color: var(--ar-text-muted);
    font-size: 11px;
}
